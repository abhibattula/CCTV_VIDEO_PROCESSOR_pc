# Raspberry Pi ARM64 base image — bakes all Python deps once via QEMU emulation.
# Subsequent source-only rebuilds use Dockerfile.pi (inherits FROM this).
#
# Base image choice: python:3.12-slim-bookworm (Debian 12) instead of
# Ubuntu 22.04 + deadsnakes, because:
#  - deadsnakes PPA publishes amd64 binaries ONLY — python3.12 is not
#    installable on arm64 from that PPA
#  - Debian 12 Bookworm uses glibc 2.36, the SAME version as Raspberry Pi OS
#    Bookworm — PyInstaller output is binary-compatible with the target OS
#  - Python 3.12 + pip come prebuilt for arm64; no PPA, no get-pip.py
#
# Build (from project root — requires QEMU binfmt registered):
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
#   docker build --platform linux/arm64 -f build/docker/Dockerfile.pi-base -t cctv-pi-base:latest .
#
# First build: ~60-90 min (QEMU ARM64 emulation + torch aarch64 wheels).
# Rebuild only when requirements change.

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# System packages:
#  - dpkg-dev: dpkg-deb for .deb packaging (create_deb.sh)
#  - binutils: objdump/objcopy required by PyInstaller on Linux
#  - libgl1 (NOT libgl1-mesa-glx — that transitional package was removed in
#    Debian Bookworm) + Qt/xcb libs required by PyInstaller PyQt6 analysis
RUN apt-get update && apt-get install -y \
        curl \
        ca-certificates \
        binutils \
        dpkg-dev \
        libgl1 \
        libglib2.0-0 \
        libxcb-xinerama0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-xkb1 \
        libxkbcommon-x11-0 \
        libegl1 \
        libdbus-1-3 \
        libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip

# CPU-only torch for aarch64 — the whl/cpu index includes ARM64 wheels
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu

# All remaining app dependencies (installed as aarch64 binaries automatically).
# No PyQt6: its aarch64 wheels need glibc >= 2.39 (Pi OS Bookworm has 2.36),
# so the Pi build is headless — launcher.py serves the web UI to the browser.
RUN pip install \
        transformers \
        open_clip_torch \
        ultralytics \
        "pyinstaller==6.21.0" \
        imageio-ffmpeg \
        fastapi \
        uvicorn \
        aiofiles \
        Pillow \
        opencv-python-headless
