# Raspberry Pi ARM64 base image — bakes all Python deps once via QEMU emulation.
# Subsequent source-only rebuilds use Dockerfile.pi (inherits FROM this).
#
# Build (from project root — requires QEMU binfmt registered):
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
#   docker build --platform linux/arm64 -f build/docker/Dockerfile.pi-base -t cctv-pi-base:latest .
#
# First build: ~60-90 min (QEMU ARM64 emulation + torch aarch64 wheels).
# Rebuild only when requirements change.

FROM arm64v8/ubuntu:22.04

ARG PYTHON_VERSION=3.12

ENV DEBIAN_FRONTEND=noninteractive

# Base system packages + Python 3.12 via deadsnakes PPA
RUN apt-get update && apt-get install -y \
        software-properties-common \
        curl \
        ca-certificates \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-venv \
        python${PYTHON_VERSION}-dev \
        python3-pip \
        dpkg-dev \
        dpkg \
    && rm -rf /var/lib/apt/lists/*

# Make python3.12 the default python/python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --install /usr/bin/python  python  /usr/bin/python${PYTHON_VERSION} 1

# System Qt/OpenGL libs required by PyInstaller analysis of PyQt6 modules (ARM64)
RUN apt-get update && apt-get install -y \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libxcb-xinerama0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-xkb1 \
        libxkbcommon-x11-0 \
        libegl1 \
        libdbus-1-3 \
        libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip

# CPU-only torch for aarch64 — the whl/cpu index includes ARM64 wheels
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu

# All remaining app dependencies (installed as aarch64 binaries automatically)
RUN pip install \
        transformers \
        open_clip_torch \
        ultralytics \
        "pyinstaller==6.21.0" \
        imageio-ffmpeg \
        PyQt6 \
        fastapi \
        uvicorn \
        aiofiles \
        Pillow \
        opencv-python-headless
